rules_version = '2';

// Trado Firestore Security Rules.
// - Every client write is denied: all mutations go through atomic Cloud Functions Callables.
// - Direct client reads are restricted strictly to:
//     1. Caller's own user profile & devices (/users/{uid}, /users/{uid}/devices/{deviceId})
//     2. Caller's own membership documents (/memberships/{id} where resource.data.userId == request.auth.uid)
//     3. Caller's own branch join documents (/membershipBranches/{id} where resource.data.userId == request.auth.uid)
//     4. Caller's own in-app notifications (/notifications/{id} where resource.data.userId == request.auth.uid)
//     5. Non-sensitive global reference catalogs (/subscriptionPlans, /permissionCatalog, /modules, /taxRegimes, and global categories/units)
// - ALL tenant business, operational, inventory, customer, vendor, and financial collections
//   are CALLABLE-ONLY (allow read, write: if false).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsDoc() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function isGlobalCatalog() {
      return signedIn() && (
        resource.data.get('organizationId', null) == null ||
        resource.data.get('isSystem', false) == true
      );
    }

    // --- Caller's own documents (Zero get() overhead) ---

    match /users/{uid} {
      allow read: if isSelf(uid);
      match /devices/{deviceId} {
        allow read: if isSelf(uid);
      }
    }

    match /memberships/{membershipId} {
      allow read: if ownsDoc();
    }

    match /membershipBranches/{membershipBranchId} {
      allow read: if ownsDoc();
    }

    match /notifications/{notificationId} {
      allow read: if ownsDoc();
    }

    // --- Non-sensitive global platform catalogs (Signed-in users) ---

    match /subscriptionPlans/{planId} {
      allow read: if signedIn() &&
        resource.data.get('isActive', true) == true &&
        resource.data.get('isPrivate', false) != true &&
        resource.data.get('isArchived', false) != true;
    }

    match /{catalog}/{docId} {
      allow read: if catalog in ['permissionCatalog', 'modules', 'taxRegimes'] && signedIn();
    }

    match /{catalog}/{docId} {
      allow read: if catalog in ['categories', 'units'] && isGlobalCatalog();
    }

    // --- Requests & Platform Governance (Callable-only, D-36..D-45) ---
    match /requests/{requestId} {
      allow read, write: if false;
      match /activity/{activityId} {
        allow read, write: if false;
      }
    }
    match /counters/{counterId} {
      allow read, write: if false;
    }
    match /platformSettings/{settingId} {
      allow read, write: if false;
    }

    // --- Everything else is callable-only (No direct client access) ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

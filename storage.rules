rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isValidImage(maxBytes) {
      return request.resource.size > 0
        && request.resource.size <= maxBytes
        && (request.resource.contentType == 'image/jpeg'
            || request.resource.contentType == 'image/png'
            || request.resource.contentType == 'image/webp');
    }
    
    // Client temporary uploads: tmp/{scope}/{uid}/{uploadId}
    // Scope is organizationId or "platform"
    match /tmp/{scope}/{uid}/{uploadId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidImage(5 * 1024 * 1024);
    }
    
    // Permanent asset paths are written exclusively by server-side Cloud Functions (Admin SDK)
    // Rules OR across matching blocks: tmp/ is excluded here so only the owner rule above can grant a tmp read.
    match /{allPaths=**} {
      allow read: if isAuthenticated() && !resource.name.matches('tmp/.*');
      allow write: if false;
    }
  }
}

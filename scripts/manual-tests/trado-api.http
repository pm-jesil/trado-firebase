### ------------------------------------------------------------------------------
### 10. PURCHASES & EXPENSES (OUTFLOWS)
### ------------------------------------------------------------------------------

### 10.1 Create Purchase Outflow (Inward Stock Intake)
POST {{functionsHost}}/outflowsCreate
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "data": {
    "organizationId": "org_test_123",
    "kind": "purchase",
    "status": "confirmed",
    "docDate": "2026-10-28T00:00:00.000Z",
    "vendorId": "VENDOR_ID_HERE",
    "lines": [
      {
        "productId": "PROD_ID_HERE",
        "itemName": "Mineral Water 1L",
        "quantity": 100,
        "unit": "btl",
        "unitPrice": 12.00,
        "grossAmount": 1200.00,
        "discountAmount": 0,
        "taxAmount": 216.00,
        "lineTotal": 1416.00,
        "addToStock": true
      }
    ],
    "subTotal": 1200.00,
    "discountTotal": 0,
    "taxTotal": 216.00,
    "totalAmount": 1416.00,
    "paidAmount": 0,
    "balanceAmount": 1416.00,
    "paymentStatus": "pending",
    "idempotencyKey": "outflow_pur_001"
  }
}

### ------------------------------------------------------------------------------
### 11. SALES & BILLS (POS & B2B)
### ------------------------------------------------------------------------------

### 11.1 Create POS Bill (Active Tax Invoice)
POST {{functionsHost}}/billsCreate
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "data": {
    "organizationId": "org_test_123",
    "salesMode": "pos",
    "documentType": "invoice",
    "status": "active",
    "items": [
      {
        "productId": "PROD_ID_HERE",
        "nameSnapshot": "Mineral Water 1L",
        "priceSnapshot": 20.00,
        "costSnapshot": 12.00,
        "quantity": 2,
        "unit": "btl",
        "subtotal": 40.00,
        "discountValue": 0,
        "taxAmount": 6.10,
        "lineTotal": 40.00
      }
    ],
    "subTotal": 33.90,
    "discountTotal": 0,
    "taxTotal": 6.10,
    "roundOff": 0,
    "totalAmount": 40.00,
    "paidAmount": 40.00,
    "balanceAmount": 0,
    "paymentStatus": "paid",
    "idempotencyKey": "bill_pos_001"
  }
}

### 11.2 Create B2B Quotation (Draft, Does Not Decrement Stock)
POST {{functionsHost}}/billsCreate
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "data": {
    "organizationId": "org_test_123",
    "salesMode": "b2b",
    "documentType": "quotation",
    "status": "draft",
    "customerId": "CUSTOMER_ID_HERE",
    "items": [
      {
        "productId": "PROD_ID_HERE",
        "nameSnapshot": "Mineral Water 1L",
        "priceSnapshot": 20.00,
        "costSnapshot": 12.00,
        "quantity": 20,
        "unit": "btl",
        "subtotal": 400.00,
        "discountValue": 0,
        "taxAmount": 61.02,
        "lineTotal": 400.00
      }
    ],
    "subTotal": 338.98,
    "discountTotal": 0,
    "taxTotal": 61.02,
    "roundOff": 0,
    "totalAmount": 400.00,
    "paidAmount": 0,
    "balanceAmount": 400.00,
    "paymentStatus": "pending",
    "idempotencyKey": "qtn_b2b_001"
  }
}

### 11.3 Finalize Quotation into Invoice (Assigns INV- number & Decrements Stock)
POST {{functionsHost}}/billsFinalize
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "data": {
    "organizationId": "org_test_123",
    "billId": "BILL_ID_HERE",
    "idempotencyKey": "fin_bill_001"
  }
}

### ------------------------------------------------------------------------------
### 12. PAYMENTS LEDGER
### ------------------------------------------------------------------------------

### 12.1 Inbound Customer Receipt
POST {{functionsHost}}/paymentsCreate
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "data": {
    "organizationId": "org_test_123",
    "direction": "in",
    "partyType": "customer",
    "partyId": "CUSTOMER_ID_HERE",
    "partyName": "Acme Hotels",
    "amount": 400.00,
    "method": "upi",
    "referenceId": "BILL_ID_HERE",
    "referenceModel": "bill",
    "idempotencyKey": "pay_cust_001"
  }
}

### ------------------------------------------------------------------------------
### 13. RETURNS & CREDIT NOTES
### ------------------------------------------------------------------------------

### 13.1 Sales Return (Restocks Inventory & Credits Customer)
POST {{functionsHost}}/returnsCreate
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "data": {
    "organizationId": "org_test_123",
    "returnType": "sales_return",
    "referenceId": "BILL_ID_HERE",
    "partyId": "CUSTOMER_ID_HERE",
    "partyName": "Acme Hotels",
    "refundMethod": "credit_note",
    "items": [
      {
        "productId": "PROD_ID_HERE",
        "nameSnapshot": "Mineral Water 1L",
        "quantity": 2,
        "unit": "btl",
        "priceSnapshot": 20.00,
        "refundAmount": 40.00,
        "reason": "Customer ordered excess",
        "disposition": "restocked_to_inventory"
      }
    ],
    "idempotencyKey": "ret_sale_001"
  }
}


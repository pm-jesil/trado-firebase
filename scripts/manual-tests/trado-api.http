### ------------------------------------------------------------------------------
### 8. PRODUCTS & INVENTORY
### ------------------------------------------------------------------------------

### 8.1 Create Product
POST {{functionsHost}}/productsCreate
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "data": {
    "organizationId": "org_test_123",
    "name": "Mineral Water 1L",
    "baseUnit": "btl",
    "sellingPrice": 20.00,
    "costPrice": 12.00,
    "taxInclusive": true,
    "taxRatePercent": 18,
    "barcode": "8901234567890",
    "trackStock": true,
    "initialStock": 50,
    "lowStockThreshold": 10,
    "hasExpiry": true,
    "idempotencyKey": "prod_create_water_001"
  }
}

### 8.2 List Products
POST {{functionsHost}}/productsList
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "data": {
    "organizationId": "org_test_123",
    "pageSize": 20
  }
}

### 8.3 Adjust Stock Manually
POST {{functionsHost}}/stockAdjust
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "data": {
    "organizationId": "org_test_123",
    "productId": "PROD_ID_HERE",
    "adjustmentType": "adjustment_in",
    "quantity": 10,
    "reason": "Found surplus stock during count",
    "idempotencyKey": "adj_stock_001"
  }
}


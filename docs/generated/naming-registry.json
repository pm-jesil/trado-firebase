{
  "version": "1.0.0",
  "description": "Trado Canonical Field Naming Registry & Forbidden Synonym Rules (D-7)",
  "rules": [
    {
      "concept": "Phone Number",
      "canonicalName": "phone",
      "forbiddenSynonyms": [
        "mobile",
        "contactNo",
        "telephone",
        "cell",
        "phoneNo",
        "mobileNo"
      ],
      "rule": "Must be named 'phone'. Value must be E.164 normalized (+CC...)."
    },
    {
      "concept": "Email Address",
      "canonicalName": "email",
      "forbiddenSynonyms": [
        "emailAddress",
        "mail",
        "e_mail",
        "email_id"
      ],
      "rule": "Must be named 'email'. Value must be trimmed and lowercased."
    },
    {
      "concept": "Party / Entity Name",
      "canonicalName": "name",
      "forbiddenSynonyms": [
        "fullName",
        "entityName"
      ],
      "rule": "Root name field is always 'name'. Specific business roles use 'legalName' or 'tradeName'."
    },
    {
      "concept": "Statutory Tax Identifier",
      "canonicalName": "taxId",
      "forbiddenSynonyms": [
        "gstin",
        "vatNumber",
        "trn",
        "tin",
        "taxRegistrationNo"
      ],
      "rule": "Generic tax registration is 'taxId'. Country-specific PAN is 'pan'."
    },
    {
      "concept": "Lifecycle Status",
      "canonicalName": "status",
      "forbiddenSynonyms": [
        "active",
        "docStatus",
        "lifecycleState"
      ],
      "rule": "Document and entity lifecycle is represented by 'status' enum (EntityStatus). Avoid parallel boolean isActive on business documents."
    },
    {
      "concept": "Internal Notes",
      "canonicalName": "notes",
      "forbiddenSynonyms": [
        "remarks",
        "comment",
        "description_notes",
        "internalNotes"
      ],
      "rule": "Private or internal tenant notes are always 'notes'."
    },
    {
      "concept": "Customer-Facing Printed Notes",
      "canonicalName": "customerNotes",
      "forbiddenSynonyms": [
        "printNotes",
        "publicNotes",
        "invoiceNotes",
        "termsNotes"
      ],
      "rule": "Notes printed on customer documents are always 'customerNotes'."
    },
    {
      "concept": "Total Financial Amount",
      "canonicalName": "totalAmount",
      "forbiddenSynonyms": [
        "grandTotal",
        "totalPrice",
        "finalTotal",
        "netPayable"
      ],
      "rule": "Overall document monetary figure is 'totalAmount'."
    },
    {
      "concept": "Audit Creator",
      "canonicalName": "createdBy",
      "forbiddenSynonyms": [
        "createdByUserId",
        "created_by",
        "creator",
        "authorUid"
      ],
      "rule": "Audit actor UID is 'createdBy'."
    },
    {
      "concept": "Audit Updater",
      "canonicalName": "updatedBy",
      "forbiddenSynonyms": [
        "updatedByUserId",
        "updated_by",
        "updater"
      ],
      "rule": "Audit actor UID is 'updatedBy'."
    },
    {
      "concept": "Entity Image Asset",
      "canonicalName": "image",
      "computedResponseName": "imageUrl",
      "storedType": "ImageRef",
      "forbiddenSynonyms": [
        "photoUrl",
        "avatarUrl",
        "logoUrl",
        "imageUrls",
        "pictureUrl",
        "photo",
        "avatar",
        "logo"
      ],
      "rule": "D-15: The single stored field is 'image' of type ImageRef = { path, contentType, width, height, sizeBytes, updatedAt } (no URL inside). The display URL is a computed, read-only response field named 'imageUrl', produced by the single hydration function hydrateImageUrl(). No stored image URLs are permitted in Firestore."
    }
  ]
}